# --- KI (optional). Ohne KI läuft die Stichwort-Prüfung trotzdem. ---
# Variante A: Claude über die Anthropic-API (beste Qualität, Unterlagen verlassen deinen Server)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Variante B: lokales Modell, z. B. Ollama auf deinem Proxmox (Unterlagen bleiben zu Hause)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://192.168.1.50:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_CHUNK_CHARS=8000

LLM_PROVIDER=none

# --- Zugangsschutz (dringend empfohlen, sobald mehr als du im Netz bist) ---
APP_USER=weg
APP_PASSWORD=

# --- Texterkennung ---
OCR_LANG=deu
OCR_DPI=300
MAX_UPLOAD_MB=200
